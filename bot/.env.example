# Copia este archivo a .env y llena las líneas vacías. .env NO se sube a Git.

# platform.openai.com > API keys
OPENAI_API_KEY=

# Supabase > Settings > API Keys > Secret keys > "default" > Copy (empieza con sb_secret_)
SUPABASE_URL=https://bjbfcxodapjaudawlsvg.supabase.co
SUPABASE_SECRET_KEY=

# pey: sin API key los cobros son falsos. Para cobrar de verdad: pon PEY_API_KEY y borra PEY_MOCK.
PEY_MOCK=1
PEY_API_KEY=

# WhatsApp del bot (con 52, sin +). Si lo pones, se vincula con un código de 8 caracteres en vez de un QR.
BOT_PHONE=

# Opcional: si tu cuenta de OpenAI no tiene gpt-5.4-mini, descomenta:
# OPENAI_MODEL=gpt-5-mini
